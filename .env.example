# 基础文本模型 (用于常规结构清洗与属性提取)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 视觉大模型配置 (用于 PDF 扫描件视觉识别及 cli/visual_referee.py 三方原图裁决)
# 生产建议显式配置支持多模态图片的模型端点 (如 gpt-4o, qwen-vl-max 等)
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Google Gemini 原生全模态 B 轨线路
EXTRACTOR_ENGINE=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# 广材物料分类库与接口配置
CATEGORY_CODE_FILE=工料机类别.xlsx
CATEGORY_ATTRS_API_URL=https://ugw.m2.com.cn/agents-toolkit/api/material-category/attrs
ILLUSTRATION_API_BASE_URL=https://ugw.m2.com.cn/agents-toolkit
ENABLE_MATERIAL_ILLUSTRATION=1
EXPORT_INTEGRITY_CERTIFICATE=0

